{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tfs/catalogo-ust-xvia",
  "description": "Catálogo de atividades do contrato da X-VIA ('004/2026 - 30524 - XVIA TECNOLOGIA LTDA', scp-api TabelaAtividades), copiado à mão. descricaoAtividade começa pelo código do ETP ('DOC.07 - …'). complexidades[].id = Custom.SGI.LancamentoAtividadeID.",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "descricaoAtividade",
          "complexidades"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "descricaoAtividade": {
            "type": "string"
          },
          "complexidades": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "complexidade",
                "valorUst"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "complexidade": {
                  "type": "string"
                },
                "valorUst": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
