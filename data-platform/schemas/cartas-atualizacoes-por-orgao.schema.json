{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cartas/atualizacoes-por-orgao",
  "description": "Órgão × ano: cartas ativas, alteradas e revisadas e alterações aprovadas (gerenciamento_historicoservico, admin_prd).",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "ano",
      "orgao",
      "orgaoSigla",
      "cartasAtivas",
      "cartasAlteradas",
      "alteracoes"
    ],
    "properties": {
      "ano": {
        "type": "integer"
      },
      "orgao": {
        "type": "string"
      },
      "orgaoSigla": {
        "type": "string"
      },
      "alteracoes": {
        "type": "integer",
        "minimum": 0
      },
      "edicoes": {
        "type": "integer",
        "minimum": 0
      },
      "revisoes": {
        "type": "integer",
        "minimum": 0
      },
      "cartasAtivas": {
        "type": "integer",
        "minimum": 0
      },
      "cartasAlteradas": {
        "type": "integer",
        "minimum": 0
      },
      "cartasRevisadas": {
        "type": "integer",
        "minimum": 0
      },
      "percentAlteradas": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    }
  }
}