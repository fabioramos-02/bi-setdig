{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tfs/sprints",
  "description": "Sprints do XVIA Team (teamsettings/iterations).",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "sprint",
      "nome",
      "inicio",
      "fim",
      "situacao"
    ],
    "properties": {
      "sprint": {
        "type": "string"
      },
      "nome": {
        "type": "string"
      },
      "inicio": {
        "type": "string"
      },
      "fim": {
        "type": "string"
      },
      "situacao": {
        "enum": [
          "encerrada",
          "atual",
          "futura"
        ]
      }
    }
  }
}
