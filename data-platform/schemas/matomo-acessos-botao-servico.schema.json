{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "matomo/acessos-botao-servico",
  "description": "Cliques em links externos (\"Acessar serviço\") por carta — Actions.getOutlinks?flat=1 cruzado com `urlExterno` do inventário. 1 chamada Matomo por período. 1 chave por período fixo — ver ADR-007.",
  "type": "object",
  "required": ["dia", "semana", "mes", "ano"],
  "properties": {
    "dia": { "$ref": "#/definitions/lista" },
    "semana": { "$ref": "#/definitions/lista" },
    "mes": { "$ref": "#/definitions/lista" },
    "ano": { "$ref": "#/definitions/lista" }
  },
  "definitions": {
    "lista": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "titulo", "urlExterno", "cliques"],
        "properties": {
          "slug": { "type": "string" },
          "titulo": { "type": "string" },
          "orgaoSigla": { "type": ["string", "null"] },
          "categoria": { "type": ["string", "null"] },
          "urlCarta": { "type": "string" },
          "urlExterno": { "type": "string" },
          "cliques": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
