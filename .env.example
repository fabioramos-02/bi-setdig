# Credenciais do data-platform (Fase 2 — ver docs/fases/03-fase-2-data-platform.md).
# Nomes idênticos aos já usados em matomo/matomo-analytics-dashboard/config.py
# e bench-carta/src/config.py — copiar valor real de lá ou pedir pra STI.
#
# Matomo/GA4 agora TAMBÉM são lidas em runtime pelos Route Handlers
# src/app/api/analytics/{portal-ms,ms-digital}/route.ts — exceção pontual ao
# ADR-001, só pro modo "Intervalo de datas" (ver ADR-010). Por isso essas
# envs (não as de Postgres) precisam existir também no painel da Vercel
# (Production + Preview), sem prefixo NEXT_PUBLIC_ — só o processo
# server-side do Route Handler as lê, nunca vão pro bundle do browser.

# --- Matomo (Portal Único) ---
MATOMO_URL=https://webanalytics.ms.gov.br/
MATOMO_SITE_ID=298
MATOMO_TOKEN=

# --- Google Analytics 4 (MS Digital App) ---
# OAuth2 hoje (mesmo padrão do matomo/bench-carta). Trocar por service account
# é um risco listado na Fase 2 — não bloqueia o scaffold inicial.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_PROPERTY_ID=

# --- SEO / Agent discovery ---
# URL canônica usada pelo src/app/sitemap.ts. Sem valor → fallback é o domínio
# de produção. Em preview da Vercel, setar pra URL do deploy pra sitemap
# apontar pra si mesmo (opcional).
NEXT_PUBLIC_SITE_URL=https://bi-setdig.vercel.app

# --- PostHog (analytics/heatmap/session replay do próprio painel) ---
# Project token "somente escrita" — segura no bundle público (prefixo NEXT_PUBLIC_).
# Region US: host padrão https://us.i.posthog.com. EU: https://eu.i.posthog.com.
# Init acontece em src/instrumentation-client.ts (Next 15.3+/16 file convention).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Postgres (Cartas de Serviço — exige VPN da SETDIG) ---
HOST=localhost
PORT=5432
USER=
PASSWORD=
BANCO=postgres

# --- SQL Server (MS Digital cadastro — exige VPN da SETDIG) ---
# Alimenta datasets/msdigital-db/v1/* (aba Contas em analytics/ms-digital).
# Pipeline roda local com VPN e publica JSON estático (ADR-001). Nunca comitar
# valores reais aqui; usar .env local (já ignorado pelo .gitignore).
MSDIGITAL_HOST=S1013.MS
MSDIGITAL_PORT=1433
MSDIGITAL_USER=usuario_MS_digital_SGD
MSDIGITAL_PASSWORD=
MSDIGITAL_BANCO=MS_digital

# --- Postgres (Controlador - Portal Único - exige VPN) ---
# Alimenta cadastros do Portal Único.
CONTROLADOR_HOST=localhost
CONTROLADOR_PORT=5432
CONTROLADOR_USER=
CONTROLADOR_PASSWORD=
BANCO_CONTROLADOR=controlador_prd

